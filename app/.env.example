# ==========================================================
# 環境変数のサンプル（キー名のみ）
# 実際の値はコミットしないこと。Vercelの「Environment Variables」画面か、
# ローカルの app/.env.local に設定する（.env.local はgit管理外）。
# 値はすべて Supabase の「Project Settings → API」から取得できる。
# ==========================================================

# SupabaseプロジェクトのURL（公開してよい値）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabaseの公開鍵（anon public key・公開してよい値）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ※ service_role（管理鍵）はこのアプリでは使用しない（RLSを完全に迂回できるため露出面を作らない）。
#    将来サーバー専用で必要になった場合も NEXT_PUBLIC_ を付けないこと（Issue #27）。

# 通知メール送信用（Resend。Phase 2 の T-07 で使用）
RESEND_API_KEY=re_xxxxxxxx
# 通知メールの宛先（スタッフのメールアドレス。カンマ区切りで複数可）
STAFF_NOTIFY_EMAILS=staff@example.com
# 通知メールの送信元（任意）。未設定なら Resend のテスト用 onboarding@resend.dev を使用。
# 独自ドメインを Resend で認証したら「樱聘 <no-reply@your-domain>」の形式に設定する。
NOTIFY_FROM_EMAIL=樱聘 YingPin <onboarding@resend.dev>

# ---------- レート制限の共有ストア（任意・Issue #30） ----------
# 登録の回数制限は、この2つが**両方**設定されていれば Upstash Redis（全インスタンス共有）で数える。
# 未設定ならインメモリで動くが、Vercelのサーバーレスはインスタンスごとに別メモリなので
# 「上限 × 起動中のインスタンス数」まで通ってしまう（＝ベストエフォート）。
# 申し込み手順はオーナー向けの docs/ops/rate-limit-store-guide.md を参照。
# ※ ブラウザからは呼ばない（サーバー→Upstash のみ）。中国からの到達性は関係しない。
UPSTASH_REDIS_REST_URL=https://xxxx-xxxxx-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
